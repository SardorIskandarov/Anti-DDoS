[Unit]
Description=Anti-DDoS Per-Service Collector (P11+P12+P13)
Documentation=file:///home/user_1/Music/Anti-DDoS/docs/clickhouse_schema.md
After=network-online.target clickhouse-server.service
Wants=network-online.target
Requires=clickhouse-server.service

[Service]
Type=simple
User=user_1
Group=user_1
WorkingDirectory=/home/user_1/Music/Anti-DDoS
ExecStartPre=/bin/rm -f /tmp/ddos_stats_socket
ExecStart=/home/user_1/Music/Anti-DDoS/ddos_monitor/venv/bin/python3 /home/user_1/Music/Anti-DDoS/ddos_monitor/main.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anti-ddos-collector

# Security: tightened where compatible with /tmp socket sharing
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=no
PrivateTmp=no

[Install]
WantedBy=anti-ddos.target
