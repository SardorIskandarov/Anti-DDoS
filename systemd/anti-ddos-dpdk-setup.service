[Unit]
Description=Anti-DDoS DPDK NIC binding setup (no-IOMMU mode, vfio-pci)
Documentation=file:///home/user_1/Music/Anti-DDoS/docs/systemd_deployment.md
DefaultDependencies=no
After=local-fs.target systemd-modules-load.service
Before=anti-ddos-engine.service
ConditionPathExists=/usr/local/bin/dpdk-devbind.py

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/user_1/Music/Anti-DDoS/systemd/dpdk-setup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anti-ddos-dpdk-setup

# Must run as root: writes to /sys/module/vfio/parameters and binds PCI devices
User=root
Group=root

# NO sandboxing: needs raw access to /sys and DPDK tooling
NoNewPrivileges=no
ProtectSystem=no

[Install]
WantedBy=anti-ddos.target
