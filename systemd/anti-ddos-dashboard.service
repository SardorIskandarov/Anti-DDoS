[Unit]
Description=Anti-DDoS Web Dashboard (P14)
Documentation=file:///home/user_1/Music/Anti-DDoS/docs/clickhouse_schema.md
After=network-online.target clickhouse-server.service
Wants=network-online.target
Requires=clickhouse-server.service

[Service]
Type=simple
User=user_1
Group=user_1
WorkingDirectory=/home/user_1/Music/Anti-DDoS
ExecStart=/home/user_1/Music/Anti-DDoS/ddos_monitor/venv/bin/python3 /home/user_1/Music/Anti-DDoS/ddos_monitor/web.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anti-ddos-dashboard

NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=no
PrivateTmp=no

[Install]
WantedBy=anti-ddos.target
