# Anti-DDoS production environment file.
#
# This file documents the format of /etc/anti-ddos/env, which holds
# production secrets that must NEVER be checked into git.
#
# Copy this file to /etc/anti-ddos/env, fill in real values, then:
#   sudo chown root:user_1 /etc/anti-ddos/env
#   sudo chmod 0640 /etc/anti-ddos/env
#
# After updating /etc/anti-ddos/env, restart the stack:
#   make restart

# === ClickHouse credentials ===
CH_PASSWORD=replace-me-with-real-password
